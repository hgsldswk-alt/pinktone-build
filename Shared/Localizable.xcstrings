    "help.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末内で処理します。共有画像には元の位置情報や端末の情報を含めません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are processed on this device. Shared cards omit original location and device data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片在本机处理。分享卡不会带上原照片的位置和设备信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片在此裝置上處理。分享卡不會帶上原照片的位置與裝置資訊。"
          }
        }
      }
    },
    "help.save": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存には写真の追加だけを許可してください。写真アプリに新しいコピーが追加されます。iCloudにしかない写真は、再読み込みや別の写真の選択をお試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow add-only access to save new copies in Photos. For iCloud-only items, try reloading or choosing another photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存时授权添加照片即可，成片将作为新照片加入相册。仅在 iCloud 中的照片可重新载入或换一张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存時授權加入照片即可，成品會作為新照片加入相簿。僅在 iCloud 中的照片可重新載入或換一張。"
          }
        }
      }
    },
