        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片統一色調"
          }
        }
      }
    },
    "home.hero": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を、\n淡いピンクに。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give photos\na soft pink tone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给照片添一抹淡粉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為照片添一抹淡粉。"
          }
        }
      }
    },
    "home.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1枚も、写真の色味を揃えたいときも。"
